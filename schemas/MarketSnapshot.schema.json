{
  "$defs": {
    "ContextToken": {
      "additionalProperties": false,
      "properties": {
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "observed": {
          "default": true,
          "title": "Observed",
          "type": "boolean"
        },
        "token_type": {
          "minLength": 1,
          "title": "Token Type",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "token_type",
        "event_time"
      ],
      "title": "ContextToken",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "calendar_state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Calendar State",
      "type": "object"
    },
    "config_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Hash"
    },
    "context_mask": {
      "items": {
        "type": "boolean"
      },
      "title": "Context Mask",
      "type": "array"
    },
    "context_tokens": {
      "items": {
        "$ref": "#/$defs/ContextToken"
      },
      "title": "Context Tokens",
      "type": "array"
    },
    "cross_asset_state": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Cross Asset State",
      "type": "object"
    },
    "data_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Data Manifest Hash",
      "type": "string"
    },
    "feature_freshness_seconds": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Feature Freshness Seconds",
      "type": "object"
    },
    "feature_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Feature Manifest Hash",
      "type": "string"
    },
    "local_features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Local Features",
      "type": "object"
    },
    "object_id": {
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "schema_version": {
      "const": "market_snapshot.v1",
      "default": "market_snapshot.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "timeframe": {
      "minLength": 1,
      "title": "Timeframe",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "venue_state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Venue State",
      "type": "object"
    }
  },
  "required": [
    "object_id",
    "as_of",
    "producer",
    "trace_id",
    "asset_id",
    "timeframe",
    "data_manifest_hash",
    "feature_manifest_hash"
  ],
  "title": "MarketSnapshot",
  "type": "object"
}
