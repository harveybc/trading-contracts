{
  "$defs": {
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ProtectiveBracket": {
      "additionalProperties": false,
      "description": "Broker-side protection legs. Never an entry trigger (finding 039).",
      "properties": {
        "stop_loss_price": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Loss Price",
          "type": "number"
        },
        "take_profit_price": {
          "exclusiveMinimum": 0.0,
          "title": "Take Profit Price",
          "type": "number"
        },
        "trailing_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trailing Distance"
        }
      },
      "required": [
        "stop_loss_price",
        "take_profit_price"
      ],
      "title": "ProtectiveBracket",
      "type": "object"
    },
    "RiskEnvelope": {
      "additionalProperties": false,
      "description": "Separate risk dimensions plus atomic reservation (finding 040).\n\n``reservation_id`` refers to a worst-case loss-at-stop reservation taken\natomically before submission and released deterministically on reject,\npartial fill, cancel and close.",
      "properties": {
        "daily_loss_budget_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Daily Loss Budget Fraction",
          "type": "number"
        },
        "gross_notional_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Gross Notional Fraction",
          "type": "number"
        },
        "margin_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Margin Fraction",
          "type": "number"
        },
        "reservation_id": {
          "minLength": 1,
          "title": "Reservation Id",
          "type": "string"
        },
        "risk_fraction_at_stop": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Risk Fraction At Stop",
          "type": "number"
        }
      },
      "required": [
        "risk_fraction_at_stop",
        "gross_notional_fraction",
        "margin_fraction",
        "daily_loss_budget_fraction",
        "reservation_id"
      ],
      "title": "RiskEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_ref": {
      "minLength": 1,
      "title": "Account Ref",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "capability_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability Snapshot Hash"
    },
    "config_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Hash"
    },
    "delta_units": {
      "title": "Delta Units",
      "type": "number"
    },
    "entry_trigger_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Trigger Price"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "instrument": {
      "minLength": 1,
      "title": "Instrument",
      "type": "string"
    },
    "intent_class": {
      "enum": [
        "risk_increasing",
        "risk_reducing"
      ],
      "title": "Intent Class",
      "type": "string"
    },
    "limit_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Price"
    },
    "object_id": {
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "order_type": {
      "enum": [
        "market",
        "limit",
        "stop"
      ],
      "title": "Order Type",
      "type": "string"
    },
    "preflight": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Preflight",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "protection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtectiveBracket"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reduce_action": {
      "anyOf": [
        {
          "enum": [
            "close",
            "flatten",
            "cancel",
            "modify_protection"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reduce Action"
    },
    "reduce_target_broker_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Reduce Target Broker Ids",
      "type": "object"
    },
    "reduce_target_order_intent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reduce Target Order Intent Id"
    },
    "risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "order_intent.v2",
      "default": "order_intent.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_intent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Asset Intent Ids",
      "type": "array"
    },
    "source_portfolio_intent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Portfolio Intent Id"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "venue": {
      "minLength": 1,
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "as_of",
    "producer",
    "trace_id",
    "account_ref",
    "asset_id",
    "venue",
    "instrument",
    "intent_class",
    "order_type",
    "delta_units",
    "idempotency_key"
  ],
  "title": "OrderIntentV2",
  "type": "object"
}
